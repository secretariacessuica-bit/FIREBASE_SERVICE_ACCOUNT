    report += "----------------------------------------------------\n";
    
    // Agrupar aprovados e reprovados
    const aprovados = [];
    const reprovados = [];
    const pendentes = [];
    
    for (const [key, test] of Object.entries(results)) {
        if (test.status === "APROVADO") {
            aprovados.push(test.desc);
        } else if (test.status === "REPROVADO") {
            reprovados.push(test.desc);
        } else {
            pendentes.push(test.desc);
        }
    }
    
    report += "TESTES APROVADOS:\n";
    if (aprovados.length > 0) {
        aprovados.forEach(t => report += `- ✅ ${t}\n`);
    } else {
        report += "- Nenhum teste aprovado ainda.\n";
    }
    report += "\n";
    
    report += "TESTES REPROVADOS:\n";
    if (reprovados.length > 0) {
        reprovados.forEach(t => report += `- ❌ ${t}\n`);
    } else {
        report += "- Nenhum teste reprovado.\n";
    }
    report += "\n";
    
    report += "PENDÊNCIAS ENCONTRADAS:\n";
    if (results.authAnonima.status === "REPROVADO") {
        report += "- ⚠️ O provedor 'Anonymous' (Autenticação Anônima) não está ativado no Firebase Console.\n";
        report += "- ⚠️ Execução dos testes adicionais suspensa/pendente devido à falha de autenticação.\n";
    } else {
        if (reprovados.length > 0) {
            report += "- ⚠️ Falhas em testes funcionais no Firestore. Verifique logs de permissão.\n";
        } else {
            report += "- Nenhuma pendência encontrada. Todas as rotinas testadas com sucesso!\n";
        }
    }
    report += "\n";
    
    report += "RECOMENDAÇÕES PARA CORREÇÃO:\n";
    if (results.authAnonima.status === "REPROVADO") {
        report += "-> Acesse o console do Firebase: https://console.firebase.google.com/project/diaconia-a38f1/authentication/providers\n";
